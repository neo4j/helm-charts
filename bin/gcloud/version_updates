#!/usr/bin/env bash
# make bash play nicely
#
set -o pipefail -o errtrace -o errexit -o nounset
shopt -s inherit_errexit
[[ -n "${TRACE:-}" ]] && set -o xtrace

HELM_CHART_VERSION="${HELM_CHART_VERSION:?HELM_CHART_VERSION is required}"
DOCKER_IMAGE_VERSION="${DOCKER_IMAGE_VERSION:?DOCKER_IMAGE_VERSION is required}"
echo "Using chart version ${HELM_CHART_VERSION} and Docker image version ${DOCKER_IMAGE_VERSION}"

HELM_CHARTS_LIST=("neo4j-shared-templates" "neo4j-admin" "neo4j-reverse-proxy" "neo4j-standalone" "neo4j-cluster-core" "neo4j-cluster-read-replica" "neo4j-cluster-headless-service" "neo4j-cluster-loadbalancer" "neo4j-gcloud-pv" "neo4j-docker-desktop-pv")

for chart in "${HELM_CHARTS_LIST[@]}"
do
  sed -i -E "s/^( *version:).*/\1 ${HELM_CHART_VERSION}/" "${chart}/Chart.yaml"
  sed -i -E "/^appVersion: \"-\"/!s/^appVersion:.*/appVersion: ${DOCKER_IMAGE_VERSION}/" "${chart}/Chart.yaml"
done

sed -i -E "s/^( *imageTag:).*/\1 \"${HELM_CHART_VERSION}\"/" neo4j-admin/values.yaml
sed -i -E "s|neo4j/helm-charts-reverse-proxy:[^\"]*|neo4j/helm-charts-reverse-proxy:${DOCKER_IMAGE_VERSION}|" neo4j-reverse-proxy/values.yaml

for chart in "${HELM_CHARTS_LIST[@]}"
do
  helm dependency update "${chart}"
  git add "${chart}/"
done
