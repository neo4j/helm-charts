#!/usr/bin/env bash
# make bash play nicely
#
set -o pipefail -o errtrace -o errexit -o nounset
shopt -s inherit_errexit
[[ -n "${TRACE:-}" ]] && set -o xtrace

HELM_CHART_VERSION="${HELM_CHART_VERSION:?HELM_CHART_VERSION is required}"
DOCKER_IMAGE_VERSION="${DOCKER_IMAGE_VERSION:?DOCKER_IMAGE_VERSION is required}"
# neo4j or neo4j-experimental
HELM_REPO_NAME="${HELM_REPO_NAME:?HELM_REPO_NAME is required}"
CHART_VERSION="${HELM_CHART_VERSION}"
echo "Using chart version ${CHART_VERSION} and docker image version ${DOCKER_IMAGE_VERSION}"
#Catch current branch to restore later
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
echo "sleeping for 300 seconds"
sleep 300
helm repo add neo4j "https://helm.neo4j.com/${HELM_REPO_NAME}"
helm repo update

echo "Pulling 5.x helm charts"
git add .
git commit -m "Update chart versions to ${CHART_VERSION}"
git push

# Create the tag on the current branch (5.26) BEFORE switching to dev
git tag -m "Tagging ${CHART_VERSION}" -a "${CHART_VERSION}"
git push --tags

echo "Pulling helm charts for version ${CHART_VERSION}"
helm pull neo4j/neo4j --version "${CHART_VERSION}" || echo "Failed to pull neo4j chart"
helm pull neo4j/neo4j-admin --version "${CHART_VERSION}" || echo "Failed to pull neo4j-admin chart"
helm pull neo4j/neo4j-headless-service --version "${CHART_VERSION}" || echo "Failed to pull neo4j-headless-service chart"
helm pull neo4j/neo4j-persistent-volume --version "${CHART_VERSION}" || echo "Failed to pull neo4j-persistent-volume chart"
helm pull neo4j/neo4j-reverse-proxy --version "${CHART_VERSION}" || echo "Failed to pull neo4j-reverse-proxy chart"
helm pull neo4j/neo4j-loadbalancer --version "${CHART_VERSION}" || echo "Failed to pull neo4j-loadbalancer chart"

# index.yaml is present only in dev branch
git checkout dev
git pull
helm repo index . --merge index.yaml --url https://github.com/neo4j/helm-charts/releases/download/"${CHART_VERSION}"
git add index.yaml
git commit -m "Updating index.yaml with chart version ${CHART_VERSION} (docker image version ${DOCKER_IMAGE_VERSION})"
git push
# Restore back to original branch
git checkout "${CURRENT_BRANCH}"